{
  "name": "@tesseramento/rules",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --only auth,firestore --project demo-tesseramento --config ../firebase.json",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tesseramento --config ../firebase.json \"vitest run\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.36.0",
    "typescript": "~6.0.0",
    "vitest": "^5.1.0"
  }
}
