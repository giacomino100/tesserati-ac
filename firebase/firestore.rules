rules_version = '2';

// Regole di accesso ai dati (specifica 001, contracts/firestore-access.md).
// Tutto è negato per impostazione predefinita. Le collezioni future vanno aggiunte PRIMA
// dell'ultima regola "nega tutto", e ognuna deve partire da isAllowed().
service cloud.firestore {
  match /databases/{database}/documents {

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Ultimo accesso con Google (auth_time) non più vecchio di 7 giorni.
    function isFreshSession() {
      return request.time.toMillis() - request.auth.token.auth_time * 1000
        <= 7 * 24 * 60 * 60 * 1000;
    }

    function ownEmail() {
      return request.auth.token.email.lower();
    }

    // Utente autorizzato: email verificata, sessione recente, email presente in elenco.
    function isAllowed() {
      return isVerified()
        && isFreshSession()
        && exists(/databases/$(database)/documents/allowedEmails/$(ownEmail()));
    }

    // Amministratore (specifica 013, utenti.md): segno `admin: true` sulla propria email in elenco, messo dalla console.
    // Stesso documento letto da isAllowed(): nessuna lettura in più.
    function isAdmin() {
      return isAllowed()
        && get(/databases/$(database)/documents/allowedEmails/$(ownEmail())).data.get('admin', false) == true;
    }

    // Elenco delle email autorizzate: l'ID del documento è l'email in minuscolo.
    // Ognuno può leggere solo il proprio documento (per sapere se è in elenco);
    // nessuna scrittura né elenco dall'app: l'elenco si gestisce dalla console.
    match /allowedEmails/{email} {
      allow get: if isVerified() && isFreshSession() && email == ownEmail();
      allow list, create, update, delete: if false;
    }

    // ---- Listini per anno associativo (specifica 003, contracts/firestore-fee-schedules.md) ----

    function isPositiveInt(v) {
      return v is int && v > 0;
    }

    // Etichetta dell'anno: 2027 -> "2027/28".
    function labelOf(year) {
      return string(year) + '/' + ((year + 1) % 100 < 10 ? '0' : '') + string((year + 1) % 100);
    }

    // Una fascia: forma esatta, importi interi > 0, quota con sconto <= quota piena.
    // `withMax` è vero per le fasce con età massima (tutte tranne `adulti`).
    function validBand(b, name, withMax) {
      return b is map
        && (withMax
          ? b.keys().hasOnly(['band', 'minAge', 'maxAge', 'fullCents', 'discountedCents'])
            && b.keys().hasAll(['band', 'minAge', 'maxAge', 'fullCents', 'discountedCents'])
            && b.maxAge is int
          : b.keys().hasOnly(['band', 'minAge', 'fullCents', 'discountedCents'])
            && b.keys().hasAll(['band', 'minAge', 'fullCents', 'discountedCents']))
        && b.band == name
        && b.minAge is int
        && isPositiveInt(b.fullCents)
        && isPositiveInt(b.discountedCents)
        && b.discountedCents <= b.fullCents;
    }

    // Forma e valori del documento (senza i metadati updatedAt/updatedBy, controllati a parte).
    function validSchedule(d) {
      return d.keys().hasOnly(['associationYear', 'label', 'minAge', 'maxHouseholdSize',
                               'acrPackageCents', 'bands', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['associationYear', 'label', 'minAge', 'maxHouseholdSize',
                            'acrPackageCents', 'bands', 'updatedAt', 'updatedBy'])
        && d.associationYear is int
        && d.label is string
        && d.minAge is int
        && d.maxHouseholdSize is int
        && isPositiveInt(d.acrPackageCents)
        && d.bands is list
        && d.bands.size() == 4
        && validBand(d.bands[0], 'acr', true)
        && validBand(d.bands[1], 'giovanissimi', true)
        && validBand(d.bands[2], 'giovani', true)
        && validBand(d.bands[3], 'adulti', false);
    }

    // Chi salva e quando: email dell'utente in minuscolo e ora della richiesta.
    function stamped(d) {
      return d.updatedBy == ownEmail() && d.updatedAt == request.time;
    }

    // Regole del PDF che non si cambiano da questa schermata: età minima, massimo del nucleo,
    // età delle fasce. L'etichetta dipende dall'anno e si controlla a parte.
    function sameFixedRules(n, o) {
      return n.minAge == o.minAge
        && n.maxHouseholdSize == o.maxHouseholdSize
        && n.bands[0].minAge == o.bands[0].minAge && n.bands[0].maxAge == o.bands[0].maxAge
        && n.bands[1].minAge == o.bands[1].minAge && n.bands[1].maxAge == o.bands[1].maxAge
        && n.bands[2].minAge == o.bands[2].minAge && n.bands[2].maxAge == o.bands[2].maxAge
        && n.bands[3].minAge == o.bands[3].minAge;
    }

    // ID del documento = anno di inizio ("2026" = 2026/27). Mai cancellabili.
    match /feeSchedules/{yearId} {
      allow get, list: if isAllowed();

      // Si crea solo l'anno dopo uno già esistente (nessun anno saltato) e `create` scatta solo
      // se il documento non esiste ancora: un anno si crea una volta sola.
      allow create: if isAllowed()
        && yearId.matches('[0-9]{4}')
        && request.resource.data.associationYear == int(yearId)
        && request.resource.data.label == labelOf(int(yearId))
        && validSchedule(request.resource.data)
        && stamped(request.resource.data)
        && exists(/databases/$(database)/documents/feeSchedules/$(string(int(yearId) - 1)))
        && sameFixedRules(request.resource.data,
             get(/databases/$(database)/documents/feeSchedules/$(string(int(yearId) - 1))).data);

      // Si modificano solo le quote: anno, etichetta e regole fisse restano quelle salvate.
      allow update: if isAllowed()
        && request.resource.data.associationYear == resource.data.associationYear
        && request.resource.data.label == resource.data.label
        && validSchedule(request.resource.data)
        && stamped(request.resource.data)
        && sameFixedRules(request.resource.data, resource.data);

      allow delete: if false;
    }

    // ---- Import degli elenchi adesioni (specifica 004, contracts/firestore-import.md) ----

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    function isCount(v) {
      return v is int && v >= 0;
    }

    // Campo facoltativo: assente, oppure testo non vuoto.
    function optionalText(d, key) {
      return !(key in d) || isNonEmptyString(d[key]);
    }

    function batchPath(id) {
      return /databases/$(database)/documents/importBatches/$(id);
    }

    // Persone e adesioni si creano solo nella stessa scrittura che crea il loro segno di import:
    // il segno non esiste prima e esiste dopo. Così un anno si importa una volta sola e tutto insieme.
    function createdWithNewBatch(id) {
      return isNonEmptyString(id) && !exists(batchPath(id)) && existsAfter(batchPath(id));
    }

    // Segno di import: ID "{anno}-{ELENCO}" con ELENCO = ACR, GIOVANI o ADULTI (specifica 005).
    // Esiste = quell'elenco dell'anno è già stato importato. Il listino non serve (specifica 008: un anno passato,
    // es. 2025/26, si importa senza listino).
    // Mai modificabile né cancellabile.
    match /importBatches/{batchId} {
      allow get, list: if isAllowed();

      // Dalla 013 l'import è riservato all'amministratore (persone e adesioni importate nascono solo con il segno).
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['associationYear', 'source', 'importedAt', 'importedBy',
                                                 'adhesionCount', 'newPersonCount', 'skippedRowCount'])
        && request.resource.data.keys().hasAll(['associationYear', 'source', 'importedAt', 'importedBy',
                                                'adhesionCount', 'newPersonCount', 'skippedRowCount'])
        && request.resource.data.associationYear is int
        && request.resource.data.source in ['ACR', 'GIOVANI', 'ADULTI']
        && batchId == string(request.resource.data.associationYear) + '-' + request.resource.data.source
        && isPositiveInt(request.resource.data.adhesionCount)
        && isCount(request.resource.data.newPersonCount)
        && isCount(request.resource.data.skippedRowCount)
        && request.resource.data.importedAt == request.time
        && request.resource.data.importedBy == ownEmail();

      allow update, delete: if false;
    }

    // Dati anagrafici ammessi (constitution III), comuni alla persona importata e a quella inserita a mano.
    function validPersonFields(d) {
      return isNonEmptyString(d.lastName)
        && isNonEmptyString(d.firstName)
        && isNonEmptyString(d.identityKey)
        && d.birthDate is string
        && d.birthDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (!('sex' in d) || d.sex in ['M', 'F'])
        && (!('taxCode' in d) || (d.taxCode is string && d.taxCode.matches('[A-Z0-9]{16}')));
    }

    // Persona inserita a mano (specifica 009): nasce solo insieme alla sua adesione "nuovo" dell'anno indicato.
    function validManualPerson(d, personId) {
      return d.keys().hasOnly(['lastName', 'firstName', 'birthDate', 'identityKey', 'sex', 'taxCode',
                               'createdInYear', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['lastName', 'firstName', 'birthDate', 'identityKey', 'createdInYear', 'createdAt',
                            'createdBy'])
        && validPersonFields(d)
        && d.createdInYear is int
        && d.createdAt == request.time
        && d.createdBy == ownEmail()
        && !exists(/databases/$(database)/documents/adhesions/$(string(d.createdInYear) + '_' + personId))
        && existsAfter(/databases/$(database)/documents/adhesions/$(string(d.createdInYear) + '_' + personId))
        && getAfter(/databases/$(database)/documents/adhesions/$(string(d.createdInYear) + '_' + personId)).data.get('origin', '') == 'nuovo';
    }

    // Anagrafica condivisa tra gli anni: solo le colonne necessarie (constitution III).
    match /persons/{personId} {
      allow get, list: if isAllowed();

      allow create: if isAllowed() && validManualPerson(request.resource.data, personId);

      allow create: if isAllowed()
        && request.resource.data.keys().hasOnly(['lastName', 'firstName', 'birthDate', 'identityKey',
                                                 'createdInImport', 'sex', 'taxCode'])
        && request.resource.data.keys().hasAll(['lastName', 'firstName', 'birthDate', 'identityKey',
                                                'createdInImport'])
        && validPersonFields(request.resource.data)
        && createdWithNewBatch(request.resource.data.createdInImport);

      allow update, delete: if false;
    }

    // Pagamento (specifica 013): giorno "AAAA-MM-GG" non futuro, registrato da chi salva, adesso.
    function validPayment(d) {
      return d.paidOn is string
        && d.paidOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        // Il giorno è quello italiano (UTC+1, +2 con l'ora legale): 2 ore di margine sulla mezzanotte di Greenwich.
        && timestamp.date(int(d.paidOn.split('-')[0]), int(d.paidOn.split('-')[1]), int(d.paidOn.split('-')[2]))
             <= request.time + duration.value(2, 'h')
        && d.paidAt == request.time
        && d.paidBy == ownEmail();
    }

    // Alla creazione il pagamento è facoltativo, ma tutto o niente.
    function optionalPayment(d) {
      return (!('paidOn' in d) && !('paidAt' in d) && !('paidBy' in d)) || validPayment(d);
    }

    // Riconferma (specifica 008, contracts/firestore-renewals.md): adesione dell'anno nuovo di chi aveva
    // un'adesione nell'anno immediatamente precedente; l'anno nuovo deve avere un listino. Le regole leggono
    // 2 documenti (adesione precedente + listino, uguale per tutte): l'app salva a gruppi di 15.
    function validRenewal(d, adhesionId) {
      return d.keys().hasOnly(['personId', 'associationYear', 'origin', 'list', 'sector', 'bond', 'bondId',
                               'renewedFrom', 'renewedAt', 'renewedBy', 'paidOn', 'paidAt', 'paidBy'])
        && optionalPayment(d)
        && d.keys().hasAll(['personId', 'associationYear', 'origin', 'list', 'sector', 'renewedFrom',
                            'renewedAt', 'renewedBy'])
        && d.origin == 'riconferma'
        && d.associationYear is int
        && isNonEmptyString(d.personId)
        && adhesionId == string(d.associationYear) + '_' + d.personId
        && d.list in ['ACR', 'GIOVANI', 'ADULTI']
        && d.sector == {'ACR': 'RAGAZZI', 'GIOVANI': 'GIOVANI', 'ADULTI': 'ADULTI'}[d.list]
        && optionalText(d, 'bond')
        && optionalText(d, 'bondId')
        && d.renewedFrom == d.associationYear - 1
        && d.renewedAt == request.time
        && d.renewedBy == ownEmail()
        && exists(/databases/$(database)/documents/adhesions/$(string(d.renewedFrom) + '_' + d.personId))
        && exists(/databases/$(database)/documents/feeSchedules/$(string(d.associationYear)));
    }

    // Nuovo tesserato (specifica 009): adesione di chi non aveva un'adesione l'anno prima (altrimenti va
    // riconfermato); persona esistente o creata nella stessa scrittura; l'anno deve avere un listino.
    function validNewAdhesion(d, adhesionId) {
      return d.keys().hasOnly(['personId', 'associationYear', 'origin', 'list', 'sector', 'addedAt', 'addedBy',
                               'paidOn', 'paidAt', 'paidBy'])
        && optionalPayment(d)
        && d.keys().hasAll(['personId', 'associationYear', 'origin', 'list', 'sector', 'addedAt', 'addedBy'])
        && d.origin == 'nuovo'
        && d.associationYear is int
        && isNonEmptyString(d.personId)
        && adhesionId == string(d.associationYear) + '_' + d.personId
        && d.list in ['ACR', 'GIOVANI', 'ADULTI']
        && d.sector == {'ACR': 'RAGAZZI', 'GIOVANI': 'GIOVANI', 'ADULTI': 'ADULTI'}[d.list]
        && d.addedAt == request.time
        && d.addedBy == ownEmail()
        && exists(/databases/$(database)/documents/feeSchedules/$(string(d.associationYear)))
        && existsAfter(/databases/$(database)/documents/persons/$(d.personId))
        && !exists(/databases/$(database)/documents/adhesions/$(string(d.associationYear - 1) + '_' + d.personId));
    }

    // Cambio di elenco (specifica 011, contracts/firestore-list-change.md): cambiano solo elenco, settore coerente,
    // settore dell'export (copiato una volta sola dalle adesioni importate) e ultimo cambio con chi/quando/nota.
    // Nessuna lettura di altri documenti: "Allinea tutte" sta in una sola scrittura.
    function validListChange(after, before) {
      return after.diff(before).affectedKeys().hasOnly(['list', 'sector', 'exportSector', 'listChange'])
        && after.list in ['ACR', 'GIOVANI', 'ADULTI']
        && after.sector == {'ACR': 'RAGAZZI', 'GIOVANI': 'GIOVANI', 'ADULTI': 'ADULTI'}[after.list]
        && after.listChange is map
        && after.listChange.keys().hasOnly(['from', 'at', 'by', 'note'])
        && after.listChange.keys().hasAll(['from', 'at', 'by'])
        && after.listChange.from in ['ACR', 'GIOVANI', 'ADULTI']
        && after.listChange.at == request.time
        && after.listChange.by == ownEmail()
        && (!('note' in after.listChange)
            || (after.listChange.note is string
                && after.listChange.note.trim().size() > 0
                && after.listChange.note.size() <= 200))
        && ('exportSector' in before
            ? after.exportSector == before.exportSector
            : (!('exportSector' in after) || after.exportSector == before.sector));
    }

    // Adesione di una persona in un anno: ID "{anno}_{personId}", una sola per persona e anno
    // qualunque sia l'elenco o l'origine (un `set` su un'adesione esistente è un update, vietato).
    match /adhesions/{adhesionId} {
      allow get, list: if isAllowed();

      allow create: if isAllowed() && validRenewal(request.resource.data, adhesionId);

      allow create: if isAllowed() && validNewAdhesion(request.resource.data, adhesionId);

      allow create: if isAllowed()
        && request.resource.data.keys().hasOnly(['personId', 'associationYear', 'importId', 'sector',
                                                 'exportAgeBand', 'bond', 'bondId'])
        && request.resource.data.keys().hasAll(['personId', 'associationYear', 'importId', 'sector'])
        && request.resource.data.associationYear is int
        && isNonEmptyString(request.resource.data.personId)
        && adhesionId == string(request.resource.data.associationYear) + '_' + request.resource.data.personId
        && request.resource.data.importId is string
        && request.resource.data.importId.matches(string(request.resource.data.associationYear) + '-(ACR|GIOVANI|ADULTI)')
        && isNonEmptyString(request.resource.data.sector)
        && optionalText(request.resource.data, 'exportAgeBand')
        && optionalText(request.resource.data, 'bond')
        && optionalText(request.resource.data, 'bondId')
        && createdWithNewBatch(request.resource.data.importId);

      // Annullare una riconferma (008) o un nuovo tesserato (009): solo se la persona non è in una famiglia
      // dell'anno (stesso formato di ID). Le adesioni importate non si cancellano.
      allow delete: if isAllowed()
        && resource.data.get('origin', '') in ['riconferma', 'nuovo']
        && !exists(/databases/$(database)/documents/familyMemberships/$(adhesionId));

      allow update: if isAllowed()
        && (validListChange(request.resource.data, resource.data)
            // "Registra pagamento" (013): solo i tre campi del pagamento.
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidOn', 'paidAt', 'paidBy'])
                && validPayment(request.resource.data))
            // Tolta a mano da una famiglia (013): non viene riaggiunta da sola.
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyOptOut'])
                && request.resource.data.familyOptOut is bool));
    }

    // ---- Famiglie per anno (specifica 007, contracts/firestore-families.md) ----

    function familyPath(id) {
      return /databases/$(database)/documents/families/$(id);
    }

    // Famiglia confermata: almeno 2 componenti (al massimo 20), origine, chi e quando.
    function validFamily(d) {
      return d.keys().hasOnly(['associationYear', 'memberIds', 'origin', 'bondId', 'confirmedAt', 'confirmedBy'])
        && d.keys().hasAll(['associationYear', 'memberIds', 'origin', 'confirmedAt', 'confirmedBy'])
        && d.associationYear is int
        && d.memberIds is list
        && d.memberIds.size() >= 2
        && d.memberIds.size() <= 20
        && d.origin in ['legame', 'manuale']
        && optionalText(d, 'bondId')
        && d.confirmedAt == request.time
        && d.confirmedBy == ownEmail();
    }

    match /families/{familyId} {
      allow get, list: if isAllowed();
      allow create: if isAllowed() && validFamily(request.resource.data);
      allow update: if isAllowed()
        && validFamily(request.resource.data)
        && request.resource.data.associationYear == resource.data.associationYear;
      // Scioglimento: l'app cancella nella stessa scrittura anche le appartenenze.
      allow delete: if isAllowed();
    }

    // Appartenenza: ID "{anno}_{personId}" = una sola famiglia per persona per anno. È la fonte di verità
    // (research R8): punta a una famiglia che, dopo la scrittura, esiste, è dello stesso anno e contiene la persona.
    match /familyMemberships/{membershipId} {
      allow get, list: if isAllowed();
      allow create, update: if isAllowed()
        && request.resource.data.keys().hasOnly(['associationYear', 'personId', 'familyId'])
        && request.resource.data.keys().hasAll(['associationYear', 'personId', 'familyId'])
        && request.resource.data.associationYear is int
        && isNonEmptyString(request.resource.data.personId)
        && isNonEmptyString(request.resource.data.familyId)
        && membershipId == string(request.resource.data.associationYear) + '_' + request.resource.data.personId
        && existsAfter(familyPath(request.resource.data.familyId))
        && getAfter(familyPath(request.resource.data.familyId)).data.associationYear == request.resource.data.associationYear
        && getAfter(familyPath(request.resource.data.familyId)).data.memberIds.hasAny([request.resource.data.personId]);
      // Si cancella solo se la persona non è più nella famiglia (o la famiglia è sciolta).
      allow delete: if isAllowed()
        && (!existsAfter(familyPath(resource.data.familyId))
            || !getAfter(familyPath(resource.data.familyId)).data.memberIds.hasAny([resource.data.personId]));
    }

    // ---- Quote dei nuclei per anno (specifica 010, contracts/firestore-fees.md) ----

    function isNonNegativeInt(v) {
      return v is int && v >= 0;
    }

    // Quota salvata: calcolata (righe del calcolo della 002) o manuale (importo del nucleo + nota obbligatoria).
    function validHouseholdFee(d, feeId) {
      return d.keys().hasOnly(['associationYear', 'householdKey', 'memberIds', 'kind', 'lines', 'acrPackageCents',
                               'manualCents', 'note', 'reason', 'totalCents', 'savedAt', 'savedBy'])
        && d.keys().hasAll(['associationYear', 'householdKey', 'memberIds', 'kind', 'totalCents', 'savedAt', 'savedBy'])
        && d.associationYear is int
        && d.householdKey is string
        && d.householdKey.matches('(f|p)-.+')
        && feeId == string(d.associationYear) + '_' + d.householdKey
        && d.memberIds is list
        && d.memberIds.size() >= 1
        && d.memberIds.size() <= 20
        && isNonNegativeInt(d.totalCents)
        && d.savedAt == request.time
        && d.savedBy == ownEmail()
        && (
          (d.kind == 'calculated'
            && d.lines is list
            && !d.keys().hasAny(['manualCents', 'note', 'reason'])
            && (!('acrPackageCents' in d) || isNonNegativeInt(d.acrPackageCents)))
          || (d.kind == 'manual'
            && !d.keys().hasAny(['lines', 'acrPackageCents'])
            && isNonNegativeInt(d.manualCents)
            && d.manualCents == d.totalCents
            && d.note is string
            && d.note.trim().size() > 0
            && d.reason in ['householdTooLarge', 'memberUnderMinAge', 'invalidInput'])
        );
    }

    match /householdFees/{feeId} {
      allow get, list: if isAllowed();
      allow create, update: if isAllowed() && validHouseholdFee(request.resource.data, feeId);
      allow delete: if isAllowed();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
